<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.NovaTransacaoController" spacing="20" alignment="TOP_CENTER">
    <padding>
        <Insets top="25" right="40" bottom="25" left="40"/>
    </padding>
    <Label text="O que você quer registrar?" styleClass="titulo"/>
    <GridPane hgap="10" vgap="15" alignment="CENTER">
        <Label text="Descrição:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoDescricao" promptText="Ex.: mercado, salário, pizza" prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Valor (R$):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoValor" promptText="Ex.: 25,90" prefWidth="300" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Data:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="campoData" prefWidth="300" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Tipo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <CheckBox fx:id="checkReceita" text="Marque se for uma entrada (desmarcado = saída)" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="labelErro" styleClass="erro"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Salvar" onAction="#salvarTransacao"/>
        <Button fx:id="botaoCancelar" text="Voltar" styleClass="botao-perigo"/>
    </HBox>
</VBox>
